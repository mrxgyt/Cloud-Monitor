# Public VPN endpoint. Leave VPN_HOST blank to use the request hostname.
VPN_HOST=

# Local Docker Compose defaults (HTTP through Nginx on port 8080).
VPN_PUBLIC_PORT=8080
VPN_SECURITY=none

# For a public HTTPS endpoint, use values like:
# VPN_HOST=vpn.example.com
# VPN_PUBLIC_PORT=443
# VPN_SECURITY=tls
VPN_FINGERPRINT=random
VPN_ALPN=h3

# Optional TLS SNI and WebSocket Host overrides.
VPN_SNI=
VPN_WS_HOST=
